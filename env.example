# ── Deliplus Store environment ─────────────────────────────
# 1. Copy this file:      cp env.example .env
# 2. Add your Stripe key: https://dashboard.stripe.com/apikeys
# 3. TEST FIRST with sk_test_... — switch to sk_live_... only after verifying.

STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
PORT=3000

# Optional (recommended): public base URL when the Origin header is missing (reverse proxies)
# BASE_URL=https://your-store.example.com

# Optional (recommended): sign webhook events
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
